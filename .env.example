# Email for Let's Encrypt certificate notifications
CERT_EMAIL=admin@yourdomain.com

# Domain configuration - comma-separated list of domains to include in certificate
# All domains will be included in a single certificate
# The first domain listed will be the primary domain (used for cert directory name)
#
# EXAMPLES:
#
# Wildcard certificate (covers *.yourdomain.com but NOT bare domain):
# DOMAINS=*.yourdomain.com
#
# Wildcard + bare domain (most common for intranet use):
# DOMAINS=yourdomain.com,*.yourdomain.com
#
# Bare domain only:
# DOMAINS=yourdomain.com
#
# Bare domain + www subdomain:
# DOMAINS=yourdomain.com,www.yourdomain.com
#
# Specific subdomains only (no wildcard):
# DOMAINS=yourdomain.com,api.yourdomain.com,blog.yourdomain.com,app.yourdomain.com
#
# Mix of wildcard and specific subdomains:
# DOMAINS=yourdomain.com,*.yourdomain.com,api.yourdomain.com
#
# Note: Wildcards only cover one level (*.yourdomain.com covers app.yourdomain.com
#       but NOT api.app.yourdomain.com)
DOMAINS=yourdomain.com,*.yourdomain.com

# Use Let's Encrypt staging server for testing (avoids rate limits)
# Set to 1 for staging, 0 for production certificates
# Always test with staging first before switching to production!
CERT_STAGING=1
