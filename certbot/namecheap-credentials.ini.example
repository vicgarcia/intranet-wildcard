# Namecheap API credentials
# Copy this file to namecheap-credentials.ini and fill in your actual credentials
#
# To get Namecheap API access you need:
# - 20+ domains in your account, OR
# - $50+ account balance, OR
# - $50+ purchases in the last 2 years
#
# Enable API access at: https://ap.www.namecheap.com/settings/tools/apiaccess/

dns_namecheap_username=your-namecheap-username
dns_namecheap_api_key=your-namecheap-api-key
